# LeadPulse Pro | Render Environment Variables
# ==========================================

# 1. Google Sheets Credentials
# Copy the ENTIRE content of your creds.json and paste it as a single line or block here.
# In Render, paste the full JSON object {...} into this value.
GOOGLE_SHEETS_CREDENTIALS='{"type": "service_account", "project_id": "...", "private_key": "...", ...}'

# 2. Google Sheet Name
# The name of your existing or new spreadsheet.
SHEET_NAME=LeadPulse_Data

# 3. App Settings (Optional for Render)
PYTHON_VERSION=3.10
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
